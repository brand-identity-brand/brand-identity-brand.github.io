# Local GitHub App authentication only.
# Copy this file to .env and keep the downloaded private key under .secrets/.
#
# In GitHub Actions, configure PORTFOLIO_APP_ID as a repository variable and
# PORTFOLIO_APP_PRIVATE_KEY as a repository secret containing the PEM value.
PORTFOLIO_APP_ID=
PORTFOLIO_APP_PRIVATE_KEY_PATH=.secrets/brand-identity-brand-portfolio-builder.private-key.pem
